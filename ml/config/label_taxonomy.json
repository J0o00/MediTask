  "sources": {
    "kimore": {
      "exercise_map": {
        "Es1": "arm_raise_bilateral",
        "Es2": "lateral_trunk_tilt",
        "Es3": "trunk_rotation",
        "Es4": "pelvis_rotation",
        "Es5": "squat"
