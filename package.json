{
  "name": "meditask-webapp",
  "version": "2.0.0",
  "description": "MediTask - AI-assisted computer-vision tele-rehabilitation platform",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "npx serve .",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:rules": "firebase emulators:exec --only firestore \"node --test tests/security-tests/\"",
    "export-configs": "node tools/export-configs.mjs",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "deploy": "firebase deploy",
    "test:e2e": "node tests/e2e/run-e2e.cjs",
    "build:css": "node tools/build-css.mjs"
  },
  "keywords": [
    "rehabilitation",
    "firebase",
    "mediapipe",
    "gru",
    "lstm",
    "tele-rehabilitation"
  ],
  "author": "Ann Rose PT",
  "license": "ISC",
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.9",
    "firebase": "^10.14.1",
    "firebase-tools": "^13.35.1",
    "tailwindcss": "^3.4.17"
  }
}
